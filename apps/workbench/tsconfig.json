{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "smoji": ["../../packages/smoji/src/index.ts"],
      "smoji/manifest": ["../../packages/smoji/src/manifest.ts"],
      "smoji/marker": ["../../packages/smoji/src/marker.ts"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ]
}
