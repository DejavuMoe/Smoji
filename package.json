{
  "name": "smoji-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "generate:packs": "node --experimental-strip-types scripts/generate-packs.mjs",
    "generate:previews": "node scripts/generate-previews.mjs",
    "build": "pnpm build:core && pnpm build:demo",
    "build:core": "node -e \"require('node:fs').rmSync('packages/smoji/dist',{recursive:true,force:true})\" && tsc -p packages/smoji/tsconfig.build.json && node scripts/build-core.mjs",
    "build:demo": "pnpm generate:packs && vite build --config vite.demo.config.ts",
    "dev": "pnpm generate:packs && vite --config vite.demo.config.ts",
    "test": "pnpm generate:packs && vitest run",
    "typecheck": "pnpm generate:packs && tsc --noEmit",
    "check:size": "node scripts/check-size.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:size"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "terser": "^5.43.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "license": "MIT",
  "description": "表情浏览、分组与评论系统配置导出"
}
