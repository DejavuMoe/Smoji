{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smoji.local/schema/smoji-v1.json",
  "title": "Smoji manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packs"],
  "properties": {
    "version": { "const": 1 },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/pack" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\]\\x00-\\x1F\\x7F]+$"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 600,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "src"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "src": { "type": "string", "minLength": 1 }
      }
    }
  }
}
